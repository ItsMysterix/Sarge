# SARGE Production Environment Template

# --- Database (Neon) ---
DATABASE_URL="postgres://user:pass@host/db?sslmode=disable"

# --- Authentication ---
NEXTAUTH_SECRET="your_secret_here"
NEXTAUTH_URL="https://sarge.vercel.app"

# --- Backend & WebSockets ---
# PORT is usually assigned by Railway (Backend tRPC + Metrics)
# WS_PORT is used for the standalone WebSocket server
WS_PORT=3001
METRICS_PORT=3000
ALLOW_ORIGINS="https://sarge.vercel.app,http://localhost:3000"

# --- Infrastructure ---
# URL of the Rust Bridge performance engine (if running as separate service)
# RUST_BRIDGE_URL="http://rust-bridge:4000/rpc"

# --- Telemetry ---
PROM_METRICS_TOKEN="your_metrics_token"
METRICS_ENABLE="true"

# --- Kubernetes (Production) ---
# Used if deploying SARGE in a self-hosting K8s environment
# KUBECONFIG_PATH="/app/secrets/kubeconfig"

# --- Integration Platform (Nango) ---
# Unified OAuth Management for 61+ Providers
NANGO_SECRET_KEY="your-nango-secret-key"
NEXT_PUBLIC_NANGO_PUBLIC_KEY="your-nango-public-key"
