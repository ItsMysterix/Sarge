# Professional .gitignore for Sarge

# Dependencies
node_modules/
**/node_modules/
.pnpm-debug.log*
pnpm-lock.yaml
package-lock.json
yarn.lock

# Next.js Build & Outputs
.next/
out/
build/
dist/
**/dist/

# Configuration & Cache
.vercel/
.turbo/
.cache/
.contentlayer/
.next-env.d.ts
*.tsbuildinfo

# Rust & Bridge Artifacts
target/
debug/
release/
*.rs.bk
rust-bridge/target/
bridge/target/

# Environment & Secrets (CRITICAL)
.env*
*.env
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test Coverage & Results
coverage/
*.lcov
.vitest-result/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Editor & Tooling
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache
.stylelintcache

# macOS & OS Secrets
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
Icon
.Spotlight-V100
.Trashes
